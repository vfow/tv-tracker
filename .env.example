SECRET_KEY=replace-with-a-generated-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tv_tracker
DB_USER=tv_tracker_user
DB_PASSWORD=replace-with-database-password
APP_USERNAME=admin
APP_PASSWORD_HASH=replace-with-tools-generate-secrets-output
TMDB_API_KEY=replace-with-tmdb-api-key

# Optional TVmaze release-timing enrichment. All switches default off.
TVMAZE_ENABLED=false
TVMAZE_SHADOW_ENABLED=false
TVMAZE_UPCOMING_ENABLED=false
TVMAZE_NOTIFICATIONS_ENABLED=false
