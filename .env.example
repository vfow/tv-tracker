SECRET_KEY=replace-with-a-generated-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tv_tracker
DB_USER=tv_tracker_user
DB_PASSWORD=replace-with-database-password
APP_USERNAME=admin
APP_PASSWORD_HASH=replace-with-tools-generate-secrets-output
TMDB_API_KEY=replace-with-tmdb-api-key

# Optional Web Push. Push remains unavailable until all three values are set.
# Generate one VAPID keypair and keep the private key server-side only.
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Optional TVmaze release-timing enrichment. All switches default off.
TVMAZE_ENABLED=false
TVMAZE_SHADOW_ENABLED=false
TVMAZE_UPCOMING_ENABLED=false
TVMAZE_NOTIFICATIONS_ENABLED=false

# Phase 4 email. Registration remains source-locked OFF regardless of these.
# Set the real HTTPS site origin; email links never use the request Host header.
APP_PUBLIC_URL=https://your-site.alwaysdata.net
APP_DISPLAY_NAME=Your tracker
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
